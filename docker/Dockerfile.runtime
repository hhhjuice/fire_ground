ARG BASE_IMAGE
FROM ${BASE_IMAGE}

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /opt/runtime

COPY requirements.txt /tmp/requirements.txt
RUN python3 -m pip install --upgrade pip setuptools wheel \
    && python3 -m pip install -r /tmp/requirements.txt \
    && rm -f /tmp/requirements.txt

COPY docker/start.sh /usr/local/bin/start-fire-ground
RUN chmod +x /usr/local/bin/start-fire-ground \
    && mkdir -p /workspace/fire_ground

WORKDIR /workspace/fire_ground
VOLUME ["/workspace/fire_ground"]
EXPOSE 8001

ENTRYPOINT ["/usr/local/bin/start-fire-ground"]