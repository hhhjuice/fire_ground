ARG BASE_IMAGE
FROM ${BASE_IMAGE}

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /opt/runtime

COPY requirements.txt /tmp/requirements.txt
RUN python3 -m pip install --upgrade pip setuptools wheel \
    && python3 -m pip install -r /tmp/requirements.txt \
    && rm -f /tmp/requirements.txt \
    && mkdir -p /app /data \
    && chown -R 10001:10001 /app /data

ENV GROUND_DB_PATH=/data/fire_ground.db

COPY --chown=10001:10001 app /app/app
COPY --chown=10001:10001 static /app/static
COPY --chown=10001:10001 docker/start.sh /usr/local/bin/start-fire-ground
RUN chmod +x /usr/local/bin/start-fire-ground

WORKDIR /app
USER 10001:10001
VOLUME ["/data"]
EXPOSE 8001
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 CMD python3 -c "import json, urllib.request; data=json.load(urllib.request.urlopen('http://127.0.0.1:8001/api/health', timeout=3)); raise SystemExit(0 if data.get('services', {}).get('database') else 1)" || exit 1

ENTRYPOINT ["/usr/local/bin/start-fire-ground"]
